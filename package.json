{
  "name": "babel-plugin-react-source-string",
  "version": "2.3.0",
  "description": "Babel plugin that adds data-source=\"path:line\" attributes to JSX elements (React components and HTML elements) for debugging",
  "author": "Jaroslav Barov jaroslav.barov@gmail.com",
  "license": "MIT",
  "keywords": [
    "babel",
    "plugin",
    "react",
    "source",
    "data-source",
    "jsx",
    "debug",
    "devtools",
    "click-to-source",
    "ai",
    "ai-agent",
    "llm",
    "cursor",
    "claude-code",
    "react-19",
    "_debugSource"
  ],
  "files": [
    "dist",
    "overlay.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./overlay.js": "./overlay.js"
  },
  "scripts": {
    "dev": "unbuild --stub",
    "build": "unbuild",
    "test:ci": "node --test \"tests/**/*.test.mjs\"",
    "test": "unbuild && node --test \"tests/**/*.test.mjs\""
  },
  "repository": "git@github.com:tanchu/babel-plugin-react-source-string.git",
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/types": "^7.28.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.2.1",
    "unbuild": "^1.2.1"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0 || ^8.0.0"
  }
}
